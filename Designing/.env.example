# Copy to `.env` and adjust. Vite only exposes variables prefixed VITE_.

# Where the Flask backend is listening (see ../backend/README.md).
VITE_API_URL=http://localhost:5000

# Mock mode is the DEFAULT — the app runs with no backend, but every result is
# simulated (a keyword match plus a coin flip), and a banner says so.
#
# Set to false to make real predictions against the Random Forest. Read
# ../backend/README.md first: the feature extractor is a reimplementation of one
# that isn't in this repo, so live accuracy is unknown and is NOT the 97.01%
# from the training notebook.
VITE_USE_MOCK=true
